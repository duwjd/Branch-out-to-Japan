  "commonConstraints": [
    "Preserve the product from the input exactly: same shape, proportions, cap, label layout, logo, and colors. Never redraw or invent anything printed on the physical package.",
    "This image is one full-width horizontal slice of a vertical detail page. Keep the composition calm and leave generous empty space where vector text will be placed on top.",
    "Keep left and right safe margins clear of important subject matter (about 6% each side).",
    "Match the mood keywords exactly; the block must sit visually next to the neighbouring blocks of the same page."
  ],
  "commonNegativeConstraints": [
    "No text, letters, kana, kanji, hangul, numbers, captions, labels, logos, badges, or watermarks anywhere in the image.",
    "No Korean (Hangul) characters anywhere.",
    "No fabricated rankings, awards, No.1 claims, SPF values, test results, graphs, review quotes, or prices.",
    "No photorealistic before/after skin-change imagery.",
    "No human faces unless a brand-owned model cut was explicitly supplied.",
    "No QR codes, no UI chrome, no borders or frames."
  ],
